<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SpendSmart</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="~/Content/FileCSS/StyleCSS.css" rel="stylesheet" />
</head>
<body>
    <div class="wrap">
        <!-- HEADER NGANG CƠ BẢN -->
        <header class="header">
            <div class="brand"><i class="fa-solid fa-sparkles"></i> SpendSmart</div>

            <div class="nav">
                <a href="/Default/Index"><i class="fa-solid fa-chart-pie"></i> Tổng quan</a>
                <a href="/Default/Transactions"><i class="fa-solid fa-credit-card"></i> Giao dịch</a>
                <a href="/Default/Weekly"><i class="fa-solid fa-calendar-week"></i> Tuần</a>
                <a href="/Default/Savings"><i class="fa-solid fa-piggy-bank"></i> Tích lũy</a>
                <a href="/Default/DepositSavings"><i class="fa-solid fa-hand-holding-dollar"></i> Gửi tiền</a>
                <a href="/Default/Budgets"><i class="fa-solid fa-bullseye"></i> Ngân sách</a>
                <a href="/Default/Analytics"><i class="fa-solid fa-chart-line"></i> Thống kê</a>
            </div>

            <div class="user">
                <span>Mỹ An</span>
                <div class="avatar">A</div>
                <a href="/Default/Login" class="btn-out" title="Đăng xuất">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </header>

        <main class="main">
            <div class="content">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- ĐOẠN SCRIPT CHUẨN ĐÃ ĐƯỢC ÉP KIỂU, KHÔNG LỖI CỤC BỘ -->
    <script type="text/javascript">
                window.openBox = function (id) {
                    var box = document.getElementById(id);
                    if (box) {
                        if (box.style.display === "none" || box.style.display === "") {
                            box.style.display = "block";
                        } else {
                            box.style.display = "none";
                        }
                    }
                };
    </script>
</body>
</html>

