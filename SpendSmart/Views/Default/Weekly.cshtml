@model IEnumerable<SpendSmart.Models.Transaction>

@{
    ViewBag.Title = "Chi Tiêu Theo Tuần 📅";
    Layout = "~/Views/Shared/_LayoutKhungWeb.cshtml";
}

<!-- Nhúng file CSS riêng của trang Weekly -->
<link href="~/Content/FileCSS/Weekly.css?v=10" rel="stylesheet" type="text/css" />

<div class="grid">
    <div class="box b-pink">
        <p>Chi tuần này 🌸</p>
        <h3>365.000 đ</h3>
    </div>
    <div class="box b-purple">
        <p>Hạn mức tuần 🎯</p>
        <h3>1.000.000 đ</h3>
    </div>
    <div class="box b-green">
        <p>Trạng thái 🍀</p>
        <h3>An toàn</h3>
    </div>
</div>

<div class="card">
    <h3 class="title">Bảng Chi Tiêu Theo Tuần</h3>
    <table class="tbl tbl-hover">
        <thead>
            <tr>
                <th>Tuần</th>
                <th>Khoảng thời gian</th>
                <th>Số tiền đã chi</th>
                <th>Tình trạng</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>Tuần 1</strong></td>
                <td>01/10 - 07/10</td>
                <td>365.000 đ</td>
                <td><span class="badge b-ok">An toàn</span></td>
            </tr>
            <tr>
                <td><strong>Tuần 2</strong></td>
                <td>08/10 - 14/10</td>
                <td>0 đ</td>
                <td><span class="badge b-ok">Đang diễn ra</span></td>
            </tr>
        </tbody>
    </table>
</div>

<hr class="line" />

<!-- NÚT MỞ DATABASE CÓ STYLE TRỰC TIẾP (ÉP MÀU XANH RÊU 100%) -->
<button class="toggle" onclick="openBox('dbWeekly')" style="background-color: #718355 !important; color: white !important; padding: 10px 18px !important; border: none !important; border-radius: 8px !important; cursor: pointer !important; font-weight: bold !important; margin-bottom: 15px;">
    📅 Xem Dữ Liệu Theo Tuần (Database)
</button>

<!-- CỤC DATABASE (ẨN MẶC ĐỊNH VÀ ĐÓNG KHUNG TRẮNG BO GÓC) -->
<div id="dbWeekly" class="card data" style="display: none; margin-top: 15px;">
    <h4 class="title" style="color: #333; margin-bottom: 12px;">Bảng Transactions Trong CSDL:</h4>
    <table class="tbl tbl-hover">
        <thead>
            <tr>
                <th>Tên Giao Dịch</th>
                <th>Số Tiền</th>
                <th>Ví Thanh Toán</th>
                <th class="tr">Ngày Giao Dịch</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td><b>@item.Title</b></td>
                        <td style="font-weight: bold;">@string.Format("{0:N0} VNĐ", item.Amount)</td>
                        <td>@item.WalletName</td>
                        <td class="tr">@(item.TransactionDate.HasValue ? item.TransactionDate.Value.ToString("dd/MM/yyyy") : "")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" style="text-align:center;">Chưa có dữ liệu trong Database.</td>
                </tr>
            }
        </tbody>
    </table>
</div>