@{
    Layout = null;
    ViewBag.Title = "Đăng nhập Google";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <link href="~/Content/StyleCss.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/FileCSS/StyleGoogleLogin.css" rel="stylesheet" />
</head>
<body class="bg">
    <div class="box">

        <div class="icon">
            <i class="fa-brands fa-google"></i>
        </div>
        <h2 class="title">Đăng nhập bằng Google</h2>
        <p class="sub">Tiếp tục tới ứng dụng SpendSmart</p>

        <form action="/Default/Index" class="form">
            <div class="group">
                <label class="lbl">
                    Email hoặc Số điện thoại:
                </label>
                <input type="email" class="inp input" required />
            </div>

            <div class="flex">
                <a href="/Default/Login" class="link">Quay lại</a>
                <button type="submit" class="btn btn-next">
                    Tiếp theo
                </button>
            </div>
        </form>
    </div>
</body>
</html>