@{
    Layout = null;
    ViewBag.Title = "Đăng nhập - SpendSmart";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <link href="~/Content/FileCSS/StyleLogin.css" rel="stylesheet" />
</head>
<body class="bg">
    <div class="box">
        <h1 class="brand">SpendSmart</h1>
        <p class="sub">Chào mừng bà quay trở lại 🌸</p>

        <div class="social-group">
            <a href="#" class="btn-social">
                <i class="fa-solid fa-fingerprint" style="color: #718355;"></i>
                Chạm quét Vân tay (Touch ID)
            </a>
            <a href="/Default/GoogleLogin" class="btn-social">
                <i class="fa-brands fa-google" style="color: #4285f4;"></i>
                Đăng nhập với Google
            </a>
        </div>

        <div class="divider">
            <span>hoặc sử dụng Email</span>
        </div>

        <form action="/Default/Index" class="form">
            <div class="group">
                <label class="lbl"><i class="fa-regular fa-envelope"></i> Địa chỉ Email:</label>
                <input type="email" class="inp" placeholder="nhapemail@gmail.com" required />
            </div>

            <div class="group">
                <label class="lbl"><i class="fa-solid fa-lock"></i> Mật khẩu:</label>
                <input type="password" class="inp" placeholder="••••••••" required />
            </div>

            <div class="flex">
                <label class="chk">
                    <input type="checkbox" /> Ghi nhớ tôi
                </label>
                <a href="#" class="link">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-right-to-bracket"></i> Đăng Nhập Ngay
            </button>
        </form>

        <p class="footer-link">
            Chưa có tài khoản? <a href="/Default/Register" class="link">Đăng ký ngay</a>
        </p>
    </div>
</body>
</html>