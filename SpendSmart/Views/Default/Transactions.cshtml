@model IEnumerable<SpendSmart.Models.Transaction>

@{
    ViewBag.Title = "Quản Lý Giao Dịch";
    Layout = "~/Views/Shared/_LayoutKhungWeb.cshtml";
}

<!-- Nhúng file CSS chuẩn đường dẫn (nếu lưu trong Content/FileCSS/Transactions.css) -->
<link href="~/Content/FileCSS/Transactions.css?v=10" rel="stylesheet" type="text/css" />

<div class="card form-box">
    <h3 class="title">Thêm Giao Dịch Mới ✍️</h3>
    <form action="/Default/Transactions">
        <div class="group">
            <label class="lbl">Tên / Nội dung giao dịch:</label>
            <input type="text" class="inp" required />
        </div>

        <div class="group">
            <label class="lbl">Số tiền (VNĐ):</label>
            <input type="number" class="inp" required />
        </div>

        <div class="group">
            <label class="lbl">Loại giao dịch:</label>
            <select class="inp">
                <option>Chi tiêu (Expense)</option>
                <option>Thu nhập (Income)</option>
            </select>
        </div>

        <div class="group">
            <label class="lbl">Tài khoản thanh toán:</label>
            <select class="inp">
                <option>Ví MoMo</option>
                <option>Vietcombank</option>
                <option>Tiền mặt</option>
            </select>
        </div>

        <button type="submit" class="btn btn-full">Lưu Giao Dịch</button>
    </form>
</div>

<div class="card">
    <h3 class="title-history">Lịch Sử Thu Chi 🧾</h3>
    <table class="tbl tbl-hover">
        <thead>
            <tr>
                <th>Nội dung</th>
                <th>Phân loại</th>
                <th>Tài khoản</th>
                <th class="tr">Số tiền</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Cà phê Highlands</td>
                <td><span class="badge b-err">Chi tiêu</span></td>
                <td>Ví MoMo</td>
                <td class="tr minus">-45.000 đ</td>
            </tr>
            <tr>
                <td>Lương Part-time</td>
                <td><span class="badge b-ok">Thu nhập</span></td>
                <td>Vietcombank</td>
                <td class="tr plus">+8.000.000 đ</td>
            </tr>
        </tbody>
    </table>
</div>

<hr class="line" />

<!-- NÚT MỞ DATABASE CÓ STYLE TRỰC TIẾP (BAO NHẬN MÀU XANH RÊU 100%) -->
<button class="toggle" onclick="openBox('dbTransactions')" style="background-color: #718355 !important; color: white !important; padding: 10px 18px !important; border: none !important; border-radius: 8px !important; cursor: pointer !important; font-weight: bold !important; margin-bottom: 15px;">
    💳 Xem Dữ Liệu Giao Dịch (Database)
</button>

<!-- CỤC DATABASE ĐÓNG KHUNG TRẮNG BO GÓC SẠCH SẼ (ẢN MẶC ĐỊNH BẰNG style="display: none;") -->
<div id="dbTransactions" class="card data" style="display: none; margin-top: 15px;">
    <h4 class="sub" style="color: #333; margin-bottom: 12px;">Bảng Transactions Trong CSDL:</h4>
    <table class="tbl tbl-hover">
        <thead>
            <tr>
                <th>Tên Giao Dịch</th>
                <th>Số Tiền</th>
                <th>Ví Thanh Toán</th>
                <th class="tr">Ngày Giao Dịch</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td><b>@item.Title</b></td>
                        <td class="bold">@string.Format("{0:N0} VNĐ", item.Amount)</td>
                        <td>@item.WalletName</td>
                        <td class="tr">@(item.TransactionDate.HasValue ? item.TransactionDate.Value.ToString("dd/MM/yyyy") : "")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="empty">Chưa có dữ liệu trong Database.</td>
                </tr>
            }
        </tbody>
    </table>
</div>